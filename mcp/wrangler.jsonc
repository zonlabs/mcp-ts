{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "vars": {
    "MCP_TS_STORAGE_TYPE": "supabase"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BRIDGE_SESSION", "class_name": "BridgeSession" },
      { "name": "OAUTH_CODES", "class_name": "OAuthCodeStore" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceConnection"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["OAuthCodeStore"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["BridgeSession"],
      "deleted_classes": ["DeviceConnection"]
    }
  ],
  "build": {
    "command": "npm run build --prefix ../packages/bridge-protocol && npm run build --prefix ../packages/tool-router && npm run build --prefix ../packages/client && npm run build --prefix ../packages/code-mode"
  }
}
