{
  "name": "@mcp-ts/remote-gateway",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Cloudflare Worker remote gateway: exposes local MCP servers at a single clean URL via OAuth 2.1 + Durable Object WebSocket relay.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wrangler.jsonc",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250505.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
