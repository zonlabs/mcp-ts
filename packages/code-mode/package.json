{
  "name": "@mcp-ts/codemode",
  "version": "0.3.0-b.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Standalone code-mode execution for MCP tools — sandboxed JS with namespace bridging, TypeScript interfaces, and tool discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"var fs=require('fs'),cp=require('child_process');['../../../mcp-server/scripts/resolve-local-pkg.cjs'].forEach(function(f){fs.existsSync(f)&&cp.execSync('node '+f,{cwd:__dirname,stdio:'inherit'})})\"",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run",
    "test:quickjs": "npm run build && vitest run tests/quickjs.test.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "optionalDependencies": {
    "isolated-vm": "^6.1.2",
    "quickjs-emscripten": "^0.31.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zonlabs/mcp-ts.git",
    "directory": "packages/code-mode"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
