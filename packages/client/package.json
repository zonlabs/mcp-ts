{
  "name": "@mcp-ts/client",
  "version": "4.0.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "A lightweight MCP client library for TypeScript with durable sessions across Redis, Supabase, Neon, and SQLite, cross-runtime agent support, and dynamic tool discovery to reduce LLM context usage.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "import": "./dist/sse.mjs",
      "require": "./dist/sse.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.mjs",
      "require": "./dist/shared.js"
    },
    "./adapters/ai": {
      "types": "./dist/adapters/ai-adapter.d.ts",
      "import": "./dist/adapters/ai-adapter.mjs",
      "require": "./dist/adapters/ai-adapter.js"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain-adapter.d.ts",
      "import": "./dist/adapters/langchain-adapter.mjs",
      "require": "./dist/adapters/langchain-adapter.js"
    },
    "./adapters/mastra": {
      "types": "./dist/adapters/mastra-adapter.d.ts",
      "import": "./dist/adapters/mastra-adapter.mjs",
      "require": "./dist/adapters/mastra-adapter.js"
    },
    "./adapters/agui-adapter": {
      "types": "./dist/adapters/agui-adapter.d.ts",
      "import": "./dist/adapters/agui-adapter.mjs",
      "require": "./dist/adapters/agui-adapter.js"
    },
    "./adapters/agui-middleware": {
      "types": "./dist/adapters/agui-middleware.d.ts",
      "import": "./dist/adapters/agui-middleware.mjs",
      "require": "./dist/adapters/agui-middleware.js"
    }
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node -e \"var fs=require('fs'),cp=require('child_process');['../../../mcp-client/scripts/resolve-local-pkg.cjs'].forEach(function(f){fs.existsSync(f)&&cp.execSync('node '+f,{cwd:__dirname,stdio:'inherit'})})\"",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "benchmark:toolrouter": "npm run build && node benchmarks/toolrouter-efficiency.mjs",
    "benchmark:toolrouter:live": "npm run build && node benchmarks/toolrouter-live.mjs",
    "supabase:push": "supabase db push",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "mcp-docs": "npm run start --prefix packages/mcp-server-docs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "redis",
    "sse",
    "server-sent-events",
    "serverless",
    "react",
    "hook",
    "anthropic",
    "claude",
    "typescript",
    "agent",
    "agents",
    "durable-sessions",
    "tool-discovery",
    "tool-router",
    "context-window",
    "sqlite",
    "supabase",
    "neon"
  ],
  "author": "MCP Assistant Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zonlabs/mcp-ts.git"
  },
  "bugs": {
    "url": "https://github.com/zonlabs/mcp-ts/issues"
  },
  "homepage": "https://github.com/zonlabs/mcp-ts#readme",
  "peerDependencies": {
    "@ag-ui/client": ">=0.0.40",
    "@langchain/core": "^1.1.39",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.0.0",
    "ai": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "ioredis": "^5.0.0",
    "json-schema-to-zod": "^2.7.0",
    "react": ">=18.0.0",
    "rxjs": ">=7.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ag-ui/client": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "json-schema-to-zod": {
      "optional": true
    }
  },
  "dependencies": {
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@ag-ui/client": "^0.0.52",
    "@langchain/core": "^1.1.39",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@neondatabase/serverless": "^1.1.0",
    "@playwright/test": "^1.58.0",
    "@supabase/supabase-js": "^2.48.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.0.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "ai": "^6.0.49",
    "better-sqlite3": "^12.6.2",
    "ioredis": "^5.9.2",
    "ioredis-mock": "^8.13.1",
    "json-schema-to-zod": "^2.7.0",
    "playwright": "^1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.27",
    "zod": "^4.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
